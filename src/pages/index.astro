---
import Card from '@components/Card.astro';
import MainLayout from '@layouts/MainLayout.astro';

import avatarImg from '@assets/img/avatar.jpg';
import blogImg from '@assets/img/blog.svg';
import clothImg from '@assets/img/cloth.png';
import juliaImg from '@assets/img/julia.png';
import pathtraceImg from '@assets/img/pathtrace.png';
import NavBar from '@components/NavBar.astro';
import Hero from '@components/Hero.astro';
---

<MainLayout
    title="Technomunk"
    description="Technomunk's online page with a couple of interactive projects and a blog."
>
    <main class="content">
        <Hero src={avatarImg}>
            Salutations! I like exploring digital creativity and would love to share some of my pet
            projects with you!
        </Hero>
        <section>
            <h1 class="header">Microprojects</h1>
            <div class="grid">
                <!-- <Card title="Online blog" href="/blog" src={blogImg} alt="Newspaper icon" /> -->
                <Card
                    title="Cloth Sim"
                    href="/cloth"
                    about="Real-time verlet cloth emulation"
                    src={clothImg}
                    alt="An example frame of the cloth simulation"
                />
                <Card
                    title="Julia Sets"
                    href="/julia"
                    src={juliaImg}
                    about="Explore the beautiful fractals structures"
                    alt="An example of Julia set"
                />
                <Card
                    title="Path Tracer"
                    href="/pathtrace"
                    about="Real-time raytracing in your browser!"
                    src={pathtraceImg}
                    alt="An example of a path traced image"
                />
            </div>
        </section>
    </main>
    <footer>
        <address class="content">
            <h2>Contact details:</h2>
            <ul>
                <li><a href="https://github.com/technomunk">Github</a></li>
                <li><a href="mailto: thegriffones@gmail.com">thegriffones@gmail.com</a></li>
            </ul>
        </address>
    </footer>
</MainLayout>
