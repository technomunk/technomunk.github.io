---
import ColorPalette from '@components/ColorPalette.astro';
import NavBar from '@components/NavBar.astro';

import MainLayout from '@layouts/MainLayout.astro';
---

<MainLayout
    title="Design Overview"
    description="Summary and examples of the design system used for the website."
>
    <NavBar sections={['principles', 'palette', 'font-faces']} />
    <main>
        <section id="principles">
            <header>Principles</header>
            <p>
                The purpose of the website is to learn, practice and display my design and web-dev
                skills. The design system is built on top of the following principles:
            </p>
            <ul>
                <li>
                    <strong>Clarity</strong> - the content should be easily understood by anyone visiting
                    the webpage.
                </li>
                <li>
                    <strong>Friendly</strong> - looking around or interacting with the website should
                    feel simple, easy and welcoming.
                </li>
                <li>
                    <strong>Sleek</strong> - the design should feel modern and polished, as it is a display
                    of my abilities.
                </li>
            </ul>
        </section>
        <section id="palette">
            <header>Palette</header>
            <p>
                To ensure a consistent experience across the website, the following color palette is
                used:
            </p>
            <ColorPalette />
        </section>
        <section id="font-faces">
            <header>Font faces</header>
            <p class="display">Display - for the page titles</p>
            <p class="giant">Diant - for chapter titles</p>
            <p class="large">Large - for section titles</p>
            <p class="title">Title - for sub-section titles</p>
            <p class="body">body - main content, blocks of paragraphs etc</p>
            <p class="mono">monospace - technical text, typically code of some kind</p>
            <p class="small">small - for adding the tiny footnotes</p>
        </section>
    </main>
</MainLayout>

<style lang="scss">
    @use 'font';

    p {
        &.display {
            @include font.text-display;
            font-weight: bold;
        }
        &.giant {
            @include font.text-giant;
            font-weight: bold;
        }
        &.large {
            @include font.text-large;
            font-weight: bold;
        }
        &.title {
            @include font.text-title;
            font-weight: bold;
        }
        &.body {
            @include font.text-body;
        }
        &.mono {
            @include font.monospace;
        }
        &.small {
            @include font.text-small;
        }
    }
</style>
