---
import BlogOverview from '@components/BlogOverview.astro';
import MainLayout from '@layouts/MainLayout.astro';
import { dateCompare } from '@lib/dateutil';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');

posts.sort((a, b) => dateCompare(b.data.publishedOn, a.data.publishedOn));
---

<MainLayout title="Technomunk's Blog" description="Technomunk's personal blog">
    <main class="text-center">
        <header>Welcome to Technomunk's blog!</header>
    </main>
    <BlogOverview posts={posts} />
</MainLayout>

<style lang="scss">
    header {
        margin-bottom: 0.5em;
    }
</style>
