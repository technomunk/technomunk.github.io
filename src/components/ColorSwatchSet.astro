---
import { capitalize } from '@lib/util';

export type ColorShade = '050' | '100' | '200' | '300' | '400' | '500' | '600' | '700' | '800' | '900';
const SHADES: ColorShade[] = ['900', '800', '700', '600', '500', '400', '300', '200', '100', '050'];

export interface Props {
    name: string;
}

const { name }: Props = Astro.props;
---

<div class="color-swatch-set">
    {
        SHADES.map((shade) => (
            <div class="color-swatch" title={`${name}-${shade}`}>
                <div
                    class="color-swatch-color inset"
                    style=`background-color: var(--color-${name}-${shade});`
                />
                <div class="color-swatch-label">{shade}</div>
            </div>
        ))
    }
</div>

<style lang="scss">
@use "font";

.color-swatch {
    display: inline-block;
    height: 70px;
    margin: 5px;
    margin-bottom: 2em;

    &>.color-swatch-color {
        display: inline-block;
        width: 50px;
        height: 50px;
        border-radius: 4px;
    }

    &>.color-swatch-label {
        width: 100%;
        text-align: center;
        @include font.text-small;
    }
}

.color-swatch-set {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 10px;

    &>.color-swatch {
        flex: 0 0 auto;
    }
}
</style>
