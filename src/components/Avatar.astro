---
import type { LocalImageProps } from 'astro:assets';
import { Image } from 'astro:assets';

export type Props = Omit<LocalImageProps, 'alt'> & { alt?: string };

const { class: extraClasses, alt = 'Avatar', ...props } = Astro.props;
---

<Image class={'avatar circle inset ' + (extraClasses ?? '')} alt={alt} {...props} />

<style lang="scss">
    @use 'palette';

    .avatar {
        aspect-ratio: 1 / 1;
        background: border-box palette.light-gradient(primary, secondary);
        border: solid transparent;
    }
</style>
