---
import type { BlogMetadata } from './BlogCard.astro';

import BlogCard from './BlogCard.astro';

export type Post = {
    data: BlogMetadata;
    id: string;
};

interface Props {
    posts: Post[];
}

const { posts } = Astro.props;
---

<nav class="grid">
    {
        posts.map((p) => (
            <BlogCard
                title={p.data.title}
                description={p.data.description}
                publishDate={p.data.publishedOn}
                href={`/blog/${p.id}`}
                tags={p.data.tags}
            />
        ))
    }
</nav>
